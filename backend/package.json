    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.64.1",
    "@opentelemetry/sdk-node": "0.205.0",
    "@stellar/stellar-sdk": "12.0.0",
    "axios": "1.14.0",
    "bcryptjs": "3.0.3",
    "bottleneck": "2.19.5",
    "bullmq": "5.1.0",
    "busboy": "1.6.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "cron-parser": "4.9.0",
    "csv-parser": "3.0.0",
    "decimal.js": "10.6.0",
    "dotenv": "16.0.0",
    "express": "4.18.2",
