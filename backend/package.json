{
  "name": "paymentflow-backend",
  "version": "1.0.0",
  "main": "src/app.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/app.js",
    "migrate": "node scripts/migrate.js",
    "migrate:rollback": "node scripts/migrate.js rollback",
    "dev": "nodemon src/app.js",
    "seed": "node ../scripts/seed-test-data.js",
    "create-wallet": "node ../scripts/create-school-wallet.js",
    "docs:jsdoc": "jsdoc -c jsdoc.config.json",
    "lint": "eslint src/ tests/ scripts/",
    "test": "jest --roots=./tests --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
