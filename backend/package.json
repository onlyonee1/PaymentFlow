    "ioredis": "5.3.0",
    "joi": "17.13.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.0.0",
    "morgan": "1.10.1",
    "multer": "1.4.5-lts.1",
    "node-cache": "5.1.2",
    "nodemailer": "6.9.0",
